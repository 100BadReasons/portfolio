---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getWork } from '../../lib/collection';
import { CATEGORIES } from '../../lib/categories';
import { SITE_NAME } from '../../lib/site';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const projects = await getWork();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { data } = project;
const preview = data.featured_preview;

/**
 * Explicit social card wins; otherwise derive one from the preview media so a
 * shared link is never a blank card.
 *
 * Deliberately NOT the raw import: that would point unfurlers at the multi-MB
 * source PNG and, because the prune step only removes *unreferenced* assets,
 * would drag the full-size original back into every published build. This
 * renders a 1.91:1 JPEG instead -- JPEG because Slack, iMessage and X still
 * handle AVIF poorly, and 1080 wide because Astro will not upscale past the
 * source and the render is 1080px across.
 *
 * withBase() is idempotent, so handing it an already-prefixed URL is safe.
 */
const ogFallback =
  preview.kind === 'image'
    ? (await getImage({
        src: preview.src,
        width: 1080,
        height: 566,
        format: 'jpeg',
        quality: 78,
      })).src
    : preview.poster;

const ogImage = data.og_image ?? ogFallback;

const posted = data.date.toLocaleDateString('en-US', {
  month: 'long', day: 'numeric', year: 'numeric',
});

const stackGroups = [
  ['Design / Preproduction', data.tech_stack.design_preproduction],
  ['CAD / 3D', data.tech_stack.cad_3d],
  ['Frontend / Logic', data.tech_stack.frontend_logic],
  ['Motion / Compositing', data.tech_stack.motion_compositing],
  ['AI Orchestration', data.tech_stack.ai_orchestration],
  ['Infrastructure', data.tech_stack.infrastructure],
].filter(([, items]) => (items as string[]).length > 0) as [string, string[]][];
---
<BaseLayout
  title={`${data.title} — ${SITE_NAME}`}
  description={data.tagline}
  path={`/work/${project.id}`}
  ogImage={ogImage}
>
  <article class="case">
    <nav class="back"><a href={withBase('/')}>&#8592; Back to feed</a></nav>

    <header class="head">
      <span class="dot" aria-hidden="true"></span>
      <div class="who">
        <span class="handle">{SITE_NAME}</span>
        <span class="place">{CATEGORIES[data.category].label}</span>
      </div>
      {!data.published && <span class="draft">Draft</span>}
    </header>

    <div class="hero">
      {preview.kind === 'image' ? (
        <Image
          src={preview.src}
          alt={preview.alt}
          widths={[640, 1080]}
          sizes="(max-width: 720px) 100vw, 680px"
          format="avif"
          loading="eager"
        />
      ) : (
        /* Animated cover. Autoplays muted and loops, like the feed card.
           `poster` paints instantly so there is no empty box while it loads. */
        <video
          muted
          loop
          playsinline
          autoplay
          poster={withBase(preview.poster)}
          width={preview.width}
          height={preview.height}
          aria-label={preview.alt}
        >
          <source src={withBase(preview.webm)} type="video/webm" />
          <source src={withBase(preview.mp4)} type="video/mp4" />
        </video>
      )}
    </div>

    <div class="col">
      <h1>{data.title}</h1>
      <p class="tagline">{data.tagline}</p>

      <dl class="meta">
        <div><dt>Role</dt><dd>{data.role}</dd></div>
        <div><dt>Date</dt><dd><time datetime={data.date.toISOString()}>{posted}</time></dd></div>
      </dl>

      {(data.live_url || data.repo_url) && (
        <p class="links">
          {data.live_url && <a href={data.live_url} target="_blank" rel="noopener noreferrer">Live site</a>}
          {data.repo_url && <a href={data.repo_url} target="_blank" rel="noopener noreferrer">Source code</a>}
        </p>
      )}

      {data.metrics.length > 0 && (
        <section class="metrics" aria-label="Results">
          {data.metrics.map((m) => (
            <div class="metric">
              <span class="value">{m.value}</span>
              <span class="label">{m.label}</span>
              {m.baseline && <span class="from">from {m.baseline}</span>}
              {m.method && <span class="method">{m.method}</span>}
            </div>
          ))}
        </section>
      )}

      {stackGroups.length > 0 && (
        <section class="stack" aria-label="Tech stack">
          {stackGroups.map(([label, items]) => (
            <div class="group">
              <h2>{label}</h2>
              <ul>{items.map((i) => <li>{i}</li>)}</ul>
            </div>
          ))}
        </section>
      )}

      {data.engineering_challenge && (
        <section class="challenge">
          <h2>Engineering challenge</h2>
          <p class="constraint">{data.engineering_challenge.constraint}</p>
          <p class="resolution">{data.engineering_challenge.resolution}</p>
        </section>
      )}

      {data.llm_orchestration && (
        <section class="llm">
          <h2>LLM orchestration</h2>
          <p>{data.llm_orchestration.summary}</p>
          <ul class="chips">
            {data.llm_orchestration.patterns.map((p) => <li>{p}</li>)}
            <li class="autonomy">{data.llm_orchestration.autonomy}</li>
          </ul>
          {data.llm_orchestration.human_in_the_loop && (
            <p class="hitl"><strong>Human in the loop:</strong> {data.llm_orchestration.human_in_the_loop}</p>
          )}
        </section>
      )}

      <div class="prose">
        <Content />
      </div>

      {data.gallery.length > 0 && (
        <section class="gallery" aria-label="Photographs">
          {data.gallery.map((g) => (
            <figure>
              <Image
                src={g.src}
                alt={g.caption}
                widths={[640, 1280]}
                sizes="(max-width: 720px) 92vw, 660px"
                format="avif"
                loading="lazy"
              />
              <figcaption>{g.caption}</figcaption>
            </figure>
          ))}
        </section>
      )}

      {data.deep_dive_media.length > 0 && (
        <section class="deep" aria-label="Deep dive media">
          <h2>Deep dive</h2>
          {data.deep_dive_media.map((m) => (
            <figure>
              {m.kind === 'vimeo' && (
                <iframe
                  src={`https://player.vimeo.com/video/${m.id}${m.hash ? `?h=${m.hash}` : ''}`}
                  title={m.caption} loading="lazy" allowfullscreen
                ></iframe>
              )}
              {m.kind === 'youtube' && (
                <iframe
                  src={`https://www.youtube-nocookie.com/embed/${m.id}`}
                  title={m.caption} loading="lazy" allowfullscreen
                ></iframe>
              )}
              {m.kind === 'local' && (
                <div class="wide" style={`--ar: ${m.width} / ${m.height}`}>
                  {m.rotate_hint && (
                    <p class="rotate" role="note">
                      This film is {(m.width / m.height).toFixed(1)}:1 &mdash; rotate your
                      phone to landscape to read it properly.
                    </p>
                  )}
                  <video
                    controls
                    playsinline
                    preload="metadata"
                    poster={m.poster ? withBase(m.poster) : undefined}
                    width={m.width}
                    height={m.height}
                  >
                    <source src={withBase(m.src)} type="video/mp4" />
                  </video>
                </div>
              )}
              {m.kind === 'r2' && (
                <video controls playsinline preload="none" poster={m.poster}>
                  <source src={m.src} />
                </video>
              )}
              <figcaption>{m.caption}</figcaption>
            </figure>
          ))}
        </section>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .case { max-width: 680px; margin: 0 auto; padding-bottom: 2rem; }
  .back { padding: 1.25rem 1rem 0.5rem; }
  .back a { font-size: 0.8rem; color: var(--text-dim); text-decoration: none; }
  .back a:hover { color: var(--text); }

  .head { display: flex; align-items: center; gap: 0.7rem; padding: 0.5rem 1rem 0.85rem; }
  .dot {
    width: 32px; height: 32px; border-radius: 50%; flex: none;
    background: conic-gradient(from 200deg, #f9ce34, #ee2a7b, #6228d7, #f9ce34);
  }
  .who { display: grid; line-height: 1.25; }
  .handle { font-size: 0.85rem; font-weight: 600; }
  .place { font-size: 0.75rem; color: var(--text-dim); }
  .draft {
    margin-left: auto; font-size: 0.65rem; font-weight: 700; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--bg); background: var(--text-dim);
    padding: 0.15rem 0.4rem; border-radius: 3px;
  }

  .hero { background: var(--surface); }

  .col { padding: 1.5rem 1rem 0; display: grid; gap: 1.75rem; }
  h1 { margin: 0; font-size: clamp(1.6rem, 5vw, 2.25rem); font-weight: 600; letter-spacing: -0.03em; }
  .tagline { margin: -1.25rem 0 0; color: var(--text-dim); font-size: 1rem; }

  .meta { margin: 0; display: grid; gap: 0.6rem; }
  .meta div { display: grid; grid-template-columns: 5rem 1fr; gap: 0.75rem; align-items: baseline; }
  .meta dt {
    font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-dim);
  }
  .meta dd { margin: 0; font-size: 0.9rem; }

  .links { margin: 0; display: flex; gap: 1.25rem; }
  .links a { font-size: 0.85rem; font-weight: 600; color: var(--accent); text-decoration: none; }
  .links a:hover { text-decoration: underline; }

  .metrics {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1px;
    background: var(--border); border: 1px solid var(--border); border-radius: var(--radius);
    overflow: hidden;
  }
  .metric { background: var(--bg); padding: 1rem; display: grid; gap: 0.25rem; }
  .metric .value { font-size: 1.6rem; font-weight: 600; letter-spacing: -0.02em; }
  .metric .label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-dim); }
  .metric .from, .metric .method {
    font-family: var(--font-mono); font-size: 0.68rem; color: var(--text-dim);
  }

  .stack { display: grid; gap: 1rem; }
  .stack h2, .challenge h2, .llm h2, .deep h2 {
    margin: 0 0 0.5rem; font-size: 0.7rem; text-transform: uppercase;
    letter-spacing: 0.12em; color: var(--text-dim); font-weight: 600;
  }
  .stack ul, .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .stack li, .chips li {
    font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-dim);
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 3px; padding: 0.15rem 0.45rem;
  }
  .chips .autonomy { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 40%, transparent); }

  .challenge .constraint { margin: 0 0 0.75rem; font-size: 1.05rem; }
  .challenge .resolution { margin: 0; color: var(--text-dim); }
  .llm p { margin: 0 0 0.75rem; }
  .hitl { font-size: 0.85rem; color: var(--text-dim); }

  /* --- MDX body --- */
  .prose { line-height: 1.7; }
  .prose :global(h2) { margin: 2.25rem 0 0.6rem; font-size: 1.15rem; font-weight: 600; }
  .prose :global(h3) { margin: 1.75rem 0 0.5rem; font-size: 1rem; font-weight: 600; }
  .prose :global(p) { margin: 0 0 1rem; }
  .prose :global(a) { color: var(--accent); }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.15rem; }
  .prose :global(pre) {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 0.9rem 1rem; overflow-x: auto; font-size: 0.8rem;
  }
  .prose :global(code) { font-size: 0.85em; }
  .prose :global(blockquote) {
    margin: 1.25rem 0; padding-left: 1rem;
    border-left: 2px solid var(--border); color: var(--text-dim);
  }
  /* Build-time Mermaid diagrams, wrapped by rehype-wrap-mermaid.
     The wrapper scrolls so a wide pipeline stays legible instead of being
     squashed to fit; !important is required because Mermaid writes an inline
     max-width on the SVG that would otherwise win. */
  .prose :global(figure.diagram) {
    margin: 1.5rem 0;
    padding: 1rem;
    overflow-x: auto;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    -webkit-overflow-scrolling: touch;
  }
  .prose :global(figure.diagram svg) {
    max-width: none !important;
    width: auto;
    height: auto;
    display: block;
    margin: 0 auto;
  }

  .gallery { display: grid; gap: 1.25rem; }
  .gallery figure { margin: 0; display: grid; gap: 0.45rem; }
  .gallery :global(img) {
    width: 100%; height: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .gallery figcaption { font-size: 0.78rem; color: var(--text-dim); }

  .deep { display: grid; gap: 1.5rem; }
  .deep figure { margin: 0; display: grid; gap: 0.5rem; }
  .deep iframe, .deep video {
    width: 100%; aspect-ratio: 16 / 9; border: 0;
    background: var(--surface); border-radius: var(--radius);
  }

  /* Ultra-wide film. Breaking out of the 680px text column is not cosmetic:
     at 5.3:1 the column gives 128px of height, the full width gives 270px.
     Capped at 92vw rather than 100vw so a vertical scrollbar cannot push the
     page into horizontal overflow. */
  .deep .wide {
    width: min(1400px, 92vw);
    margin-left: 50%;
    transform: translateX(-50%);
  }
  .deep .wide video {
    /* Native aspect, so there is no letterboxing to shrink the text. */
    aspect-ratio: var(--ar);
    height: auto;
  }
  .rotate {
    display: none;
    margin: 0 0 0.5rem;
    font-size: 0.78rem;
    color: var(--text-dim);
    border-left: 2px solid var(--accent);
    padding-left: 0.6rem;
  }
  /* Only worth saying on a phone held upright. */
  @media (max-width: 700px) and (orientation: portrait) {
    .rotate { display: block; }
  }
  .deep figcaption { font-size: 0.8rem; color: var(--text-dim); }
</style>
