---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileHeader from '../components/feed/ProfileHeader.astro';
import FilterBar from '../components/feed/FilterBar.astro';
import FeedPost from '../components/feed/FeedPost.astro';
import { getWork } from '../lib/collection';
import { SITE_NAME } from '../lib/site';
import { CATEGORY_IDS, type CategoryId } from '../lib/categories';

const projects = await getWork();

// Only offer filters for disciplines that actually have work in them, ordered
// by the CATEGORIES declaration so the bar is stable rather than following
// whatever order the newest project happens to sort into.
const used = new Set(projects.map((p) => p.data.category));
const present = CATEGORY_IDS.filter((id) => used.has(id)) as CategoryId[];
---
<BaseLayout
  title={`${SITE_NAME} — Work`}
  description="Software engineering, 3D product design, and motion by Kendall Willis."
  path="/"
  hasBanner
>
  <ProfileHeader projectCount={projects.length} categoryCount={present.length} />
  <FilterBar active={present} />

  <main class="feed" data-feed>
    {projects.map((project) => <FeedPost project={project} />)}

    {/* Two distinct empty states. Nothing published at all is a different
        situation from a filter that matched nothing, and saying "in this
        discipline" when the whole feed is empty reads as a bug. */}
    {projects.length === 0 && (
      <p class="empty">Work in progress &mdash; the first projects go live shortly.</p>
    )}
    <p class="empty" data-filter-empty hidden>No projects in this discipline yet.</p>
  </main>
</BaseLayout>

<style>
  .feed { padding: 1.5rem 0 0; }

  /* ---- TEMPORARY layout comparison ----------------------------------------
     Append ?layout=grid or ?layout=wide to the feed URL to preview an
     alternative desktop layout. Remove this block, the data-layout script and
     the [data-layout] rules once a direction is chosen. Default (no param) is
     unchanged, so nobody arriving at the site sees an experiment.            */

  /* Two-column grid above 1100px. */
  @media (min-width: 1100px) {
    .feed[data-layout='grid'] {
      max-width: 1000px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.75rem;
      align-items: start;
    }
    .feed[data-layout='grid'] :global(.post) {
      max-width: none;
      margin: 0;
    }
  }

  /* Wider single column. */
  @media (min-width: 760px) {
    .feed[data-layout='wide'] :global(.post) {
      max-width: 640px;
    }
  }
  /* ---- end temporary block ---- */
  .empty {
    max-width: 470px;
    margin: 3rem auto;
    text-align: center;
    color: var(--text-dim);
    font-size: 0.9rem;
  }
  @media (max-width: 640px) {
    .feed { padding-top: 0.75rem; }
  }
</style>

<script>
  /**
   * The only client JavaScript on the site. Two jobs:
   *   1. filter the feed by discipline
   *   2. autoplay muted preview loops when they scroll into view
   *
   * Both degrade gracefully: with JS off, every post renders and videos simply
   * do not autoplay. Nothing is hidden behind script.
   */
  /* TEMPORARY: ?layout=grid | wide previews an alternative desktop layout.
     Remove alongside the [data-layout] CSS once a direction is chosen. */
  const layout = new URL(location.href).searchParams.get('layout');
  if (layout === 'grid' || layout === 'wide') {
    document.querySelector('[data-feed]')?.setAttribute('data-layout', layout);
  }

  const posts = [...document.querySelectorAll<HTMLElement>('.post')];
  const pills = [...document.querySelectorAll<HTMLButtonElement>('.pill')];
  const empty = document.querySelector<HTMLElement>('[data-filter-empty]');

  function apply(filter: string, push = true) {
    let shown = 0;
    for (const post of posts) {
      const match = filter === 'all' || post.dataset.category === filter;
      post.hidden = !match;
      if (match) shown++;
    }
    // Only meaningful when there are posts to filter; with an empty feed the
    // server-rendered "work in progress" message covers it instead.
    if (empty) empty.hidden = shown > 0 || posts.length === 0;

    for (const pill of pills) {
      const on = pill.dataset.filter === filter;
      pill.classList.toggle('is-active', on);
      pill.setAttribute('aria-pressed', String(on));
    }

    // Keep the filter in the URL so a filtered view is shareable and the
    // back button behaves the way people expect.
    if (push) {
      const url = new URL(location.href);
      if (filter === 'all') url.searchParams.delete('filter');
      else url.searchParams.set('filter', filter);
      history.pushState({ filter }, '', url);
    }
  }

  for (const pill of pills) {
    pill.addEventListener('click', () => apply(pill.dataset.filter ?? 'all'));
  }
  addEventListener('popstate', () => {
    apply(new URL(location.href).searchParams.get('filter') ?? 'all', false);
  });

  // Always run once on load. Previously this only ran when a ?filter= param
  // was present, so on a feed with no visible posts the empty state stayed
  // hidden and the page rendered a blank gap.
  apply(new URL(location.href).searchParams.get('filter') ?? 'all', false);

  /* --- in-view autoplay, Instagram style --- */
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const videos = [...document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]')];

  if (videos.length && !reduced && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            // preload="none" means the source is only fetched once a post is
            // actually approaching the viewport, so off-screen posts cost 0 KB.
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        }
      },
      { rootMargin: '128px 0px', threshold: 0.4 },
    );
    for (const video of videos) io.observe(video);
  }
</script>
