---
import { SITE_NAME, CONTACT } from '../../lib/site';
import { withBase } from '../../lib/url';

interface Props { projectCount: number; categoryCount: number }
const { projectCount, categoryCount } = Astro.props;
---
<section class="profile">
  <!--
    The wordmark is a video: chrome-textured lettering on black, matching the
    page background exactly so it sits seamlessly with no visible edge.

    It carries the site name, so the name has to exist as real text for screen
    readers and search engines -- hence the visually hidden h1 with the video
    marked decorative beside it.

    preload="none" keeps 1.2 MB off the critical path. The 9 KB poster paints
    immediately and playback starts once the page has loaded, so the banner
    never delays first paint.
  -->
  <div class="banner">
    <h1 class="sr-only">{SITE_NAME}</h1>
    <video
      id="wordmark"
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      poster={withBase('/media/banner/wordmark.avif')}
      width="1188"
      height="432"
      data-src={withBase('/media/banner/wordmark.mp4')}
    ></video>
  </div>

  <div class="identity">
    <p class="name">{CONTACT.name}</p>
    <p class="bio">Software engineering, 3D product design, and motion.</p>
    <dl class="stats">
      <div><dd>{projectCount}</dd><dt>projects</dt></div>
      <div><dd>{categoryCount}</dd><dt>disciplines</dt></div>
    </dl>
  </div>
</section>

<script>
  /**
   * Start the banner only after the page has loaded, so 1.2 MB of video never
   * competes with content for bandwidth. With reduced motion requested, the
   * poster is left in place and the video is never fetched at all.
   */
  const video = document.getElementById('wordmark') as HTMLVideoElement | null;
  const src = video?.dataset.src;

  if (video && src && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const start = () => {
      // Set as a property, not just the HTML attribute: some browsers only
      // grant autoplay when muted is true on the element object at play() time.
      video.muted = true;
      video.src = src;
      video.play().catch(() => {
        /* Autoplay refused; the poster stays, which is a complete fallback. */
      });
    };
    if (document.readyState === 'complete') start();
    else addEventListener('load', start, { once: true });
  }
</script>

<style>
  .profile { max-width: var(--max-w); margin: 0 auto; }

  /* Full-bleed within the content column: the wordmark runs edge to edge. */
  .banner { line-height: 0; }
  .banner video {
    width: 100%;
    height: auto;
    aspect-ratio: 1188 / 432;
    display: block;
    background: var(--bg);
  }

  .identity { padding: 0.25rem 1rem 1.5rem; display: grid; gap: 0.35rem; }
  .name { margin: 0; font-size: 0.95rem; font-weight: 700; }
  .bio { margin: 0; font-size: 0.9rem; color: var(--text-dim); max-width: 46ch; }

  .stats { display: flex; gap: 1.5rem; margin: 0.15rem 0 0; }
  .stats div { display: flex; gap: 0.35rem; }
  .stats dd { margin: 0; font-weight: 600; font-size: 0.85rem; }
  .stats dt { color: var(--text-dim); font-size: 0.85rem; }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }
</style>
