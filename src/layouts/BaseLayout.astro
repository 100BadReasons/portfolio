---
import { absoluteUrl, withBase } from '../lib/url';
import { GOATCOUNTER_CODE, LAUNCHED, SITE_NAME } from '../lib/site';
import SiteFooter from '../components/primitives/SiteFooter.astro';
import TopBar from '../components/feed/TopBar.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  /** True on pages showing the banner wordmark, so the top bar can defer its
   *  own copy of the name until the banner scrolls away. */
  hasBanner?: boolean;
}
const { title, description, path, ogImage, hasBanner = false } = Astro.props;
const canonical = absoluteUrl(path, Astro.site);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* Pre-launch: keep the work-in-progress site out of search results.
        Flip LAUNCHED in src/lib/site.ts to remove this everywhere. */}
    {!LAUNCHED && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    {ogImage && <meta property="og:image" content={absoluteUrl(ogImage, Astro.site)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    {/* GoatCounter. Gated on the same flag as indexing, so a pre-launch site is
        neither crawled nor counted. `is:inline` keeps Astro from bundling it —
        it must stay a plain async tag pointing at gc.zgo.at. */}
    {LAUNCHED && GOATCOUNTER_CODE && (
      <script
        is:inline
        async
        data-goatcounter={`https://${GOATCOUNTER_CODE}.goatcounter.com/count`}
        src="https://gc.zgo.at/count.js"></script>
    )}
  </head>
  <body>
    <TopBar hasBanner={hasBanner} />
    <slot />
    <SiteFooter />
  </body>
</html>
